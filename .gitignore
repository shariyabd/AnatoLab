# Local Claude Code overrides (machine-specific, not team config)
.claude/settings.local.json

# Laravel (from Handover 01 onward)
/vendor
/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/framework/testing/*
/storage/logs/*
/bootstrap/cache/*
.env
.env.*
!.env.example
.phpunit.result.cache
/.php-cs-fixer.cache

# Local SQLite database (development fallback when MySQL is unavailable)
/database/*.sqlite
/database/*.sqlite-journal

# Test and analysis caches
/.phpunit.cache
/.phpstan.cache
/test-results
/playwright-report
/tests/Browser/.auth

# 3D assets — large binaries, managed by Handover 02
/public/models/*.glb
/public/models/*.gltf

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
