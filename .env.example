APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# AI tutor — Handover 08
# ------------------------------------------------------------------------------
# APPEND ONLY. Handover 11 appends its vector-store and retrieval keys after
# this block; never reorder these lines.
#
# `null` is the default and is what the whole test suite uses. Swapping to a
# real provider is this one variable and nothing else (docs/architecture.md §8.1).
AI_PROVIDER=null

# Server-side only. Never referenced from a VITE_* variable, an Inertia prop, or
# any client bundle (docs/engineering.md §10).
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-sonnet-5
ANTHROPIC_BASE_URL=https://api.anthropic.com

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Per user, per endpoint (docs/architecture.md §8.4).
AI_TUTOR_PER_MINUTE=20
AI_TUTOR_PER_DAY=200
AI_HINT_PER_MINUTE=30

# 20s timeout, one retry, then a graceful message. A student is waiting.
AI_TIMEOUT_SECONDS=20
AI_RETRIES=1
AI_RETRY_DELAY_MS=400

AI_TUTOR_HISTORY_TURNS=6
AI_TUTOR_MAX_TOKENS=700
AI_TUTOR_TEMPERATURE=0.3

# ------------------------------------------------------------------------------
# RAG and knowledge base — Handover 11
# ------------------------------------------------------------------------------
# APPEND ONLY, after Handover 08's block; never reorder those lines.
#
# MySQL is the DEFAULT store, not a fallback: at MVP corpus size a filtered
# cosine scan in PHP is sub-50ms and needs no extension, no external service and
# no credentials (docs/architecture.md §8.1). `pinecone` is the alternate and
# proves the seam; `null` is an in-memory store and is what the test suite uses.
# Switching between them is this one variable and no code change.
VECTOR_STORE=mysql

# Both stores read this. It must match the embedding model in use: a corpus
# embedded at one width and queried at another scores every chunk zero.
VECTOR_DIMENSIONS=1536

# Server-side only, and only read when VECTOR_STORE=pinecone. Never referenced
# from a VITE_* variable, an Inertia prop, or any client bundle.
PINECONE_API_KEY=
PINECONE_HOST=
PINECONE_NAMESPACE=anatolab

# Anthropic publishes no embeddings endpoint. Leave this unset to embed with
# whatever AI_PROVIDER selected, or set it to `openai` to run Anthropic for chat
# and OpenAI for vectors. `anthropic` is rejected at boot rather than at ingest.
AI_EMBEDDING_PROVIDER=
AI_EMBEDDING_BATCH_SIZE=64
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Top-k and the relevance floor. Below the floor the tutor answers from curated
# structure metadata and says so, rather than citing a weak match (PRD §24).
AI_RETRIEVAL_TOP_K=5
AI_RETRIEVAL_MIN_SCORE=0.65

# Uploads land on the private disk (storage/app/private), outside the web root,
# under generated names. Plain text and Markdown only — every binary format
# needs a parser dependency, which is a human decision.
KNOWLEDGE_DISK=local
KNOWLEDGE_MAX_UPLOAD_KB=8192

# ~500-token chunks with ~50 tokens of overlap, counted in words
# (docs/architecture.md §8.3).
KNOWLEDGE_CHUNK_WORDS=375
KNOWLEDGE_CHUNK_OVERLAP_WORDS=38
